<Project>
  <PropertyGroup>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!--
      The last published release. Package validation (src/Directory.Build.targets) checks the public API against it
      and test/Linq2GraphQL.Compat runs a client generated by it against it and against this code. Move it with
      scripts/update-compat-baseline.ps1, never by hand.
    -->
    <Linq2GraphQLBaselineVersion>1.0.67-prerelease</Linq2GraphQLBaselineVersion>
  </PropertyGroup>
</Project>
