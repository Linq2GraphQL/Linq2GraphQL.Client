@page "/generate-client"

<h3>Generate Client</h3>

<div class="dimmer @(isLoading ? "active" : "")">
    <div class="loader"></div>
    <div class="dimmer-content">

        <ItemSelect Items="demoOptions" @bind-SelectedValue="options" SelectedTextExpression="e=>e.ClientName">
            <ListTemplate>
                @context.ClientName
            </ListTemplate>
        </ItemSelect>

        <Card class="mt-3">
            <CardBody>
                <DataGrid>
                    <DataGridItem Title="Name">
                        <InputText class="form-control" @bind-Value="options.ClientName"/>
                    </DataGridItem>
                    <DataGridItem Title="Namespace">
                        <InputText class="form-control" @bind-Value="options.Namespace"/>
                    </DataGridItem>

                    <DataGridItem Title="Enum Strategy">
                        <ItemSelect Items="EnumHelper.GetList<EnumGeneratorStrategy>()"
                                    @bind-SelectedValue="options.EnumGeneratorStrategy"/>
                    </DataGridItem>

                    <DataGridItem Title="Include subscriptions">
                        <Checkbox Switch @bind-Value="options.IncludeSubscriptions"/>
                    </DataGridItem>

                    <DataGridItem Title="Nullable client">
                        <Checkbox Switch @bind-Value="options.Nullable"/>
                    </DataGridItem>

                    <DataGridItem Title="Include Deprecated">
                        <Checkbox Switch @bind-Value="options.IncludeDeprecated"/>
                    </DataGridItem>

                    <DataGridItem Title="Description attributes">
                        <Checkbox Switch @bind-Value="options.DescriptionAttributes"/>
                    </DataGridItem>

                    <DataGridItem Title="Standalone">
                        <Checkbox Switch @bind-Value="options.Standalone"/>
                    </DataGridItem>

                    <DataGridItem Title="Agent mode (preview)">
                        <Checkbox Switch @bind-Value="options.Agent"/>
                    </DataGridItem>

                    <DataGridItem Title="Scalar mappings">
                        @foreach (var mapping in options.ScalarMappings)
                        {
                            <div class="d-flex gap-2 mb-2">
                                <InputText class="form-control" placeholder="Scalar, e.g. Long"
                                           @bind-Value="mapping.Scalar"/>
                                <InputSelect class="form-select" @bind-Value="mapping.Target">
                                    <option value="">CustomScalar class</option>
                                    @foreach (var target in Linq2GraphQL.Generator.Helpers.SupportedTargetTypeNames)
                                    {
                                        <option value="@target">@target</option>
                                    }
                                </InputSelect>
                                <Button OnClick="() => options.ScalarMappings.Remove(mapping)">Remove</Button>
                            </div>
                        }
                        <Button OnClick="() => options.ScalarMappings.Add(new())">Add mapping</Button>
                        <div class="form-hint mt-1">
                            Maps a GraphQL scalar to a C# type, overriding the built-in mapping. Choose
                            CustomScalar class to generate a class for a scalar that is mapped by default.
                        </div>
                    </DataGridItem>

                </DataGrid>

                <div class="mt-3"/>
                <Tabs>
                    <Tab Title="Url">
                        <DataGrid>
                            <DataGridItem Title="Url">
                                <InputText class="form-control" @bind-Value="options.Url"/>
                            </DataGridItem>
                            <DataGridItem Title="Token">
                                <InputText class="form-control" @bind-Value="options.Token"/>
                            </DataGridItem>
                        </DataGrid>


                        <Button class="mt-3" BackgroundColor="TablerColor.Primary" OnClick="GenerateClientAsync">Generate
                        </Button>

                    </Tab>

                    <Tab Title="Schema (SDL / JSON)">

                        <div class="mb-2">
                            Upload or paste the schema as SDL (<code>schema.graphql</code>), or as the result of this
                            <Icon class="icon" IconType="Icons.Copy" OnClick="CopyIntrospection"/>
                            introspection query. The format is detected from the content.
                        </div>

                        <InputFile class="form-control mb-2" OnChange="LoadSchemaFileAsync"
                                   accept=".graphql,.graphqls,.gql,.sdl,.json,.txt"/>

                        <InputTextArea class="form-control font-monospace" @bind-Value="options.Schema" rows="20"
                                       placeholder="type Query { ... }"/>

                        <Button class="mt-3" BackgroundColor="TablerColor.Primary" OnClick="GenerateClientFromSchema">
                            Generate @(IsIntrospectionJson(options.Schema) ? "from introspection JSON" : "from SDL")
                        </Button>
                    </Tab>

                </Tabs>


            </CardBody>
        </Card>

    </div>
</div>
