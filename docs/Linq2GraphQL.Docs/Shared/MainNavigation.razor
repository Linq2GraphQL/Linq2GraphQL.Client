<Navbar Background="NavbarBackground.Dark" Direction="NavbarDirection.Vertical">

    <a href="https://github.com/linq2graphql/linq2graphql.client" class="navbar-brand navbar-brand-autodark">
        <img src="img/logo.svg" alt="Linq2GraphQL" class="navbar-brand-image me-2">
        <h2 class="text-secondary">
            Linq2GraphQL
            <div class="fs-6 lh-1 fst-italic">Version: @ThisAssembly.AssemblyFileVersion</div>
        </h2>
    </a>

    <NavbarMenu>
        <NavbarMenuItem Href="" Text="Home">
            <MenuItemIcon>
                <Icon class="icon" IconType="@Icons.Home"/>
            </MenuItemIcon>
        </NavbarMenuItem>

        <NavbarMenuItem Href="getting-started" Text="Getting Started">
            <MenuItemIcon>
                <Icon class="icon" IconType="@Icons.Rocket"/>
            </MenuItemIcon>
        </NavbarMenuItem>

        <NavbarMenuItem Text="Guides" ExpandWhenActive="true">
            <MenuItemIcon>
                <Icon class="icon" IconType="@Icons.Book"/>
            </MenuItemIcon>

            <SubMenu>
                <NavbarMenuItem Href="selecting-fields" Text="Selecting Fields"/>
                <NavbarMenuItem Href="error-handling" Text="Error Handling"/>
                <NavbarMenuItem Href="paging" Text="Paging"/>
                <NavbarMenuItem Href="subscriptions" Text="Subscriptions"/>
                <NavbarMenuItem Href="agent-mode" Text="Agent Mode"/>
            </SubMenu>
        </NavbarMenuItem>

        <NavbarMenuItem Href="generator" Text="Generator">
            <MenuItemIcon>
                <Icon class="icon" IconType="@Icons.Terminal_2"/>
            </MenuItemIcon>
        </NavbarMenuItem>

        <NavbarMenuItem Href="generate-client" Text="Online Generator">
            <MenuItemIcon>
                <Icon class="icon" IconType="@Icons.Adjustments_code"/>
            </MenuItemIcon>
        </NavbarMenuItem>

    </NavbarMenu>
</Navbar>