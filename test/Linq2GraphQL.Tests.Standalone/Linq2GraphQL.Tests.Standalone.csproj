<Project Sdk="Microsoft.NET.Sdk">

    <!--
      The Linq2GraphQL.Tests suite, compiled a second time against the standalone SampleClient
      (Linq2GraphQL.TestClientStandalone), which carries its own copy of the runtime. Nothing here
      references the runtime packages, so a passing run proves the copy works on its own.
      StandaloneNamespaces.cs points the namespaces the tests import at the copy.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing"/>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="Moq"/>
        <PackageReference Include="Shouldly"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Linq2GraphQL.TestClientStandalone\Linq2GraphQL.TestClientStandalone.csproj"/>
        <ProjectReference Include="..\Linq2GraphQL.TestServer\Linq2GraphQL.TestServer.csproj"/>
    </ItemGroup>

    <!--
      Left out: tests of the generator, the AI package and the nullable client, which need those
      projects, and CoexistenceTests, which needs the package-based client next to the standalone one.
    -->
    <ItemGroup>
        <Compile Include="..\Linq2GraphQL.Tests\**\*.cs"
                 Exclude="..\Linq2GraphQL.Tests\bin\**;..\Linq2GraphQL.Tests\obj\**;
                          ..\Linq2GraphQL.Tests\Agent*Tests.cs;
                          ..\Linq2GraphQL.Tests\CoexistenceTests.cs;
                          ..\Linq2GraphQL.Tests\DescriptionAttributeTests.cs;
                          ..\Linq2GraphQL.Tests\ExampleFormatterTests.cs;
                          ..\Linq2GraphQL.Tests\GeneratorCollection.cs;
                          ..\Linq2GraphQL.Tests\QueryNullableTests.cs;
                          ..\Linq2GraphQL.Tests\QueryValidatorTests.cs;
                          ..\Linq2GraphQL.Tests\SampleClientNullableFixture.cs;
                          ..\Linq2GraphQL.Tests\ScalarMappingTests.cs;
                          ..\Linq2GraphQL.Tests\ScalarTests.cs;
                          ..\Linq2GraphQL.Tests\SchemaRendererTests.cs;
                          ..\Linq2GraphQL.Tests\ScopedSchemaTests.cs;
                          ..\Linq2GraphQL.Tests\Sdl*Tests.cs;
                          ..\Linq2GraphQL.Tests\StandaloneGeneratorTests.cs"
                 Link="Tests\%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

</Project>
