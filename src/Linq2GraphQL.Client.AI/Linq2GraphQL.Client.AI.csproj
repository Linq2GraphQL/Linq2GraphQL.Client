<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>

        <Authors>Joakim Dangården,Magnus Ahlberg</Authors>
        <Company>Linq2GraphQL</Company>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/linq2graphql/linq2graphql.client</RepositoryUrl>
        <PackageProjectUrl>https://linq2graphql.com/</PackageProjectUrl>
        <Title>Linq2GraphQL.Client.AI</Title>
        <Description>Agent mode for Linq2GraphQL: expose a scoped, validated GraphQL schema to AI agents</Description>
        <Copyright>Copyright 2023 (c) Joakim Dangården. All rights reserved.</Copyright>
        <PackageTags>Linq GraphQL Client AI Agent</PackageTags>
    </PropertyGroup>

    <!--
      Agent mode ships as a preview until the pilots are evaluated: it keeps the core packages' version but always
      packs as a prerelease, so a stable release (1.0.45) publishes this package as 1.0.45-preview. Remove this
      target to release it as stable.
    -->
    <Target Name="AddPreviewSuffix" AfterTargets="GetBuildVersion">
        <PropertyGroup Condition="!$(PackageVersion.Contains('-'))">
            <PackageVersion>$(PackageVersion)-preview</PackageVersion>
            <NuGetPackageVersion>$(PackageVersion)</NuGetPackageVersion>
        </PropertyGroup>
    </Target>

    <ItemGroup>
        <InternalsVisibleTo Include="Linq2GraphQL.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Linq2GraphQL.Client\Linq2GraphQL.Client.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GraphQL-Parser"/>
        <PackageReference Include="Microsoft.Extensions.AI.Abstractions"/>
    </ItemGroup>

</Project>
