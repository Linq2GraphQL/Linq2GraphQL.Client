<#@ template language="C#" #>
<#@ assembly name="System.Core" #>
using Linq2GraphQL.Client;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Options;

namespace <#= namespaceName #>;

/// <summary>
/// GraphQL client for <#= name #> operations
/// </summary>
/// <remarks>
/// Provides strongly-typed access to GraphQL queries, mutations, and subscriptions.
/// Supports dependency injection for better testability and flexibility.
/// </remarks>
public class <#= name #> : <#= Interfaces #>
{
    private readonly GraphClient client;

    /// <summary>
    /// Constructor with dependency injection support
    /// </summary>
    /// <param name="httpClient">HTTP client for GraphQL requests</param>
    /// <param name="options">GraphQL client configuration options</param>
    /// <param name="provider">Service provider for dependency resolution</param>
<# if (includeQuery) { #>
    /// <param name="queryMethods">Optional query methods implementation (uses default if null)</param>
<# } #>
<# if (includeMutation) { #>
    /// <param name="mutationMethods">Optional mutation methods implementation (uses default if null)</param>
<# } #>
<# if (includeSubscriptions) { #>
    /// <param name="subscriptionMethods">Optional subscription methods implementation (uses default if null)</param>
<# } #>
    public <#= name #>(
        HttpClient httpClient, 
        [FromKeyedServices("<#= name #>")] IOptions<GraphClientOptions> options, 
        IServiceProvider provider<# if (includeQuery) { #>,
        I<#= GetParameterName(queryType) #> queryMethods = null<# } #><# if (includeMutation) { #>,
        I<#= GetParameterName(mutationType) #> mutationMethods = null<# } #><# if (includeSubscriptions) { #>,
        I<#= GetParameterName(subscriptionType) #> subscriptionMethods = null<# } #>)
    {
        client = new GraphClient(httpClient, options, provider, <#= includeDeprecated.ToString().ToLower() #>);
<# if (includeQuery) { #>
        Query = queryMethods ?? new <#= GetTypeName(queryType) #>(client);
<# } #>
<# if (includeMutation) { #>
        Mutation = mutationMethods ?? new <#= GetTypeName(mutationType) #>(client);
<# } #>
<# if (includeSubscriptions) { #>
        Subscription = subscriptionMethods ?? new <#= GetTypeName(subscriptionType) #>(client);
<# } #>
    }

    private <#= name #>(GraphClient client)
    {
        this.client = client;
<# if (includeQuery) { #>
        Query = new <#= GetTypeName(queryType) #>(client);
<# } #>
<# if (includeMutation) { #>
        Mutation = new <#= GetTypeName(mutationType) #>(client);
<# } #>
<# if (includeSubscriptions) { #>
        Subscription = new <#= GetTypeName(subscriptionType) #>(client);
<# } #>
    }

    /// <summary>
    /// A client that shares this client's connection and settings, and also runs
    /// <paramref name="configureRequest"/> on every request it sends. Use it for per-user or
    /// per-conversation headers such as an access token. This client is not changed.
    /// </summary>
    /// <remarks>
    /// The new client uses the generated operation implementations, not ones passed to the constructor.
    /// </remarks>
    public <#= name #> WithRequestConfiguration(Func<HttpRequestMessage, CancellationToken, ValueTask> configureRequest)
    {
        return new <#= name #>(client.WithRequestConfiguration(configureRequest));
    }

    /// <summary>
    /// A client that sends <c>Authorization: Bearer &lt;token&gt;</c> on every request, asking
    /// <paramref name="getAccessToken"/> for the token each time. This client is not changed.
    /// </summary>
    public <#= name #> WithAccessToken(Func<CancellationToken, ValueTask<string>> getAccessToken)
    {
        return WithRequestConfiguration(RequestConfigurations.BearerToken(getAccessToken));
    }
<# if (agent) { #>

    /// <summary>
    /// The schema this client was generated from, as SDL.
    /// </summary>
    public static string Sdl => <#= name #>Schema.Sdl;
<# } #>

<# if (includeQuery) { #>
    /// <summary>
    /// Gets the query methods for this GraphQL client
    /// </summary>
    public I<#= GetTypeName(queryType) #> Query { get; private set; }
<# } #>
<# if (includeMutation) { #>
    /// <summary>
    /// Gets the mutation methods for this GraphQL client
    /// </summary>
    public I<#= GetTypeName(mutationType) #> Mutation { get; private set; }
<# } #>
<# if (includeSubscriptions) { #>
    /// <summary>
    /// Gets the subscription methods for this GraphQL client
    /// </summary>
    public I<#= GetTypeName(subscriptionType) #> Subscription { get; private set; }
<# } #>
}