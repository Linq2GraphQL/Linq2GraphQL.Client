<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>Linq2GraphQL</ToolCommandName>

        <Authors>Joakim Dangården, Magnus Ahlberg</Authors>
        <Company>Linq2GraphQL</Company>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/linq2graphql/linq2graphql.client</RepositoryUrl>
        <PackageProjectUrl>https://linq2graphql.com/</PackageProjectUrl>
        <Title>Linq2GraphQL.Generator</Title>
        <Description>Generates Linq2GraphQL Client</Description>
        <Copyright>Copyright 2023 (c) Joakim Dangården. All rights reserved.</Copyright>
        <PackageTags>Linq GraphQL Client Generator</PackageTags>
        <PackageIcon>icon.png</PackageIcon>

    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\icon.png" Pack="true" PackagePath="\" Visible="false"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.CodeDom"/>
        <PackageReference Include="System.CommandLine"/>
        <PackageReference Include="GraphQL-Parser"/>
        <PackageReference Include="Macross.Json.Extensions"/>
    </ItemGroup>

    <!--
      T4 templates are preprocessed at build time by the dotnet-t4 CLI tool
      (pinned in .config/dotnet-tools.json) into "<Template>.g.cs" next to each
      .tt file. That output is generated, gitignored and never checked in, so
      editing a .tt file can never silently build stale logic. See DEVELOPER.md.
    -->
    <ItemGroup>
        <T4Template Include="Templates\Class\*.tt" TemplateNamespace="Templates.Class"/>
        <T4Template Include="Templates\Client\*.tt" TemplateNamespace="Templates.Client"/>
        <T4Template Include="Templates\Enum\*.tt" TemplateNamespace="Templates.Enum"/>
        <T4Template Include="Templates\Interface\*.tt" TemplateNamespace="Templates.Interface"/>
        <T4Template Include="Templates\Methods\*.tt" TemplateNamespace="Templates.Methods"/>
        <T4Template Include="Templates\Scalars\*.tt" TemplateNamespace="Templates.Scalars"/>

        <!-- Added by IncludeT4Output below, once the files exist. -->
        <Compile Remove="Templates\**\*.g.cs"/>
    </ItemGroup>

    <Target Name="RestoreT4Tool" Inputs="$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)t4-tool.restored">
        <Exec Command="dotnet tool restore"/>
        <Touch Files="$(IntermediateOutputPath)t4-tool.restored" AlwaysCreate="true"/>
    </Target>

    <Target Name="PreprocessT4Templates"
            DependsOnTargets="RestoreT4Tool"
            Inputs="@(T4Template)"
            Outputs="@(T4Template->'%(RelativeDir)%(Filename).g.cs')">
        <Exec Command="dotnet t4 --class=&quot;$(RootNamespace).%(T4Template.TemplateNamespace).%(T4Template.Filename)&quot; --out=&quot;%(T4Template.RelativeDir)%(T4Template.Filename).g.cs&quot; &quot;%(T4Template.Identity)&quot;"/>
    </Target>

    <Target Name="IncludeT4Output" DependsOnTargets="PreprocessT4Templates" BeforeTargets="BeforeCompile">
        <ItemGroup>
            <Compile Include="@(T4Template->'%(RelativeDir)%(Filename).g.cs')"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\Linq2GraphQL.Client\Linq2GraphQL.Client.csproj"/>
    </ItemGroup>

    <!--
      Standalone mode writes a copy of the runtime next to the generated client. The
      runtime source is embedded from the same commit as the templates, so the two always match.
      Assembly.cs only holds InternalsVisibleTo for the package assemblies and is not copied. The
      agent tools (Linq2GraphQL.Client.AI) are copied only for clients generated in agent mode.
    -->
    <ItemGroup>
        <EmbeddedResource Include="..\Linq2GraphQL.Client\**\*.cs"
                          Exclude="..\Linq2GraphQL.Client\bin\**;..\Linq2GraphQL.Client\obj\**;..\Linq2GraphQL.Client\Assembly.cs"
                          LogicalName="Runtime/Client/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\Linq2GraphQL.Client.Subscriptions\**\*.cs"
                          Exclude="..\Linq2GraphQL.Client.Subscriptions\bin\**;..\Linq2GraphQL.Client.Subscriptions\obj\**;..\Linq2GraphQL.Client.Subscriptions\Assembly.cs"
                          LogicalName="Runtime/Subscriptions/%(RecursiveDir)%(Filename)%(Extension)"/>
        <EmbeddedResource Include="..\Linq2GraphQL.Client.AI\**\*.cs"
                          Exclude="..\Linq2GraphQL.Client.AI\bin\**;..\Linq2GraphQL.Client.AI\obj\**"
                          LogicalName="Runtime/AI/%(RecursiveDir)%(Filename)%(Extension)"/>
    </ItemGroup>

    <!--
      The package versions the runtime is built against (Directory.Packages.props), so standalone mode
      can tell the user which packages the copied runtime needs.
    -->
    <Target Name="WritePackageVersions" BeforeTargets="BeforeCompile">
        <PropertyGroup>
            <PackageVersionsFile>$(IntermediateOutputPath)PackageVersions.g.cs</PackageVersionsFile>
        </PropertyGroup>
        <ItemGroup>
            <_PackageVersionLine Include="@(PackageVersion->'        [&quot;%(Identity)&quot;] = &quot;%(Version)&quot;,')"/>
        </ItemGroup>
        <WriteLinesToFile File="$(PackageVersionsFile)" Overwrite="true" WriteOnlyWhenDifferent="true"
                          Lines="namespace Linq2GraphQL.Generator%3B;internal static class PackageVersions;{;    public static readonly Dictionary&lt;string, string&gt; All = new();    {;@(_PackageVersionLine);    }%3B;}"/>
        <ItemGroup>
            <Compile Include="$(PackageVersionsFile)"/>
            <FileWrites Include="$(PackageVersionsFile)"/>
        </ItemGroup>
    </Target>

</Project>
